{
  "fluid": true,
  "rewrites": [{"source": "/(.*)", "destination": "/api/index"}],
  "functions": {
    "api/index.py": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/v1/stocks/prewarm",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/health",
      "schedule": "0 3 * * *"
    }
  ]
}
